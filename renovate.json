{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "github-actions": {
    "enabled": true,
    "pinDigests": true
  },
  "includePaths": [
    "package.json",
    "package-lock.json",
    ".github/workflows/**"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "groupName": "dev dependencies",
      "commitMessageTopic": "dev dependencies"
    },
    {
      "description": "Hold TypeScript below 7: @typescript-eslint and typedoc peer ranges do not accept TS 7 yet",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "Major updates stay manual",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on the first day of the month"
    ]
  },
  "automerge": true,
  "platformAutomerge": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  }
}
